# =============================================================================
# .env.test.example — Variables de entorno para los tests de carga
#
# Copiar a .env.test y completar con valores reales:
#   cp .env.test.example .env.test
#
# IMPORTANTE: .env.test está en .gitignore — nunca commitear credenciales reales.
# =============================================================================

# DSN de la base de datos (requerido para verificación post-test con psql)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# URL del backend a testear
BASE_URL=http://localhost:8080

# JWT de operador con rol SELLER o ADMIN.
# Si está vacío, se auto-genera consultando la DB via gen_test_jwt.
JWT_TOKEN=

# Token de un ticket CON_COMIDA en estado USADO_ENTRADA para el Escenario 2.
# Si está vacío, el setup_fixtures.js lo genera automáticamente.
FOOD_TOKEN=

# Cantidad de tickets a crear en la fase de setup (default: 50).
# Aumentar si la quota lo permite.
FIXTURE_COUNT=50
